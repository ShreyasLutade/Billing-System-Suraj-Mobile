# Copy to deploy/gcp/.env and fill in before `docker compose up`.
# NEVER commit the real .env file.

NODE_ENV=production
PORT=4000
DATABASE_URL=file:/data/suraj.db
TRUST_PROXY=1

# Hostname Cloudflare proxies to this VM (used by Caddyfile.full)
API_HOSTNAME=api.yourdomain.com

# Comma-separated browser origins allowed to call the API
# Include your Cloudflare Pages URL (and custom domain if any)
CLIENT_ORIGIN=https://billing.yourdomain.com,https://your-project.pages.dev

JWT_SECRET=replace-with-long-random-secret-at-least-32-chars

SHOP_NAME=Smart Billing
SHOP_TAGLINE=Mobile shop billing · Stock · Dues · GST
SHOP_ADDRESS=Demo storefront — replace with your shop address
SHOP_PHONE=0000000000
SHOP_INSTAGRAM=@smartbilling
SHOP_GSTIN=DEMOGSTIN0000
SHOP_HSN=8517

# Email — on GCP, Gmail SMTP usually works; Resend HTTPS also works.
REPORT_EMAIL_TO=surajmobile33556@gmail.com
RESEND_API_KEY=
# RESEND_FROM=Smart Billing Reports <onboarding@resend.dev>
SMTP_USER=surajmobilereports@gmail.com
SMTP_PASS=
SMTP_PORT=587
REPORT_CRON=0 23 * * 0,2,5
REPORT_CRON_ENABLED=true
REPORT_CRON_SECRET=replace-with-long-random-cron-secret

# Daily SQLite .db email backup (Asia/Kolkata). Default 11:30 PM IST daily.
BACKUP_DB_CRON_ENABLED=true
BACKUP_DB_CRON=30 23 * * *
BACKUP_DB_KEEP_DAYS=14

# Temporary same-origin UI from the API container (0=Pages hosts UI, 1=API serves UI)
SERVE_CLIENT=0
