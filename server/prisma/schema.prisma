generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String
  passwordHash String
  name         String
  /// ADMIN | STAFF
  role         String
  /// Repair-only account for this repair shop (see lib/repairShops). Null = full
  /// Babu Mobile NX access (mobile shop + its repair desk).
  repairShop   String?
  /// Blocked accounts keep their data but cannot log in.
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phone])
  @@unique([phone, role])
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  phone     String
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

/// Latest known customer profile by phone — used for bill autofill.
model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id                String           @id @default(cuid())
  invoiceNumber     String           @unique
  billDate          DateTime         @default(now())
  customerName      String
  customerPhone     String
  customerAddress   String?
  notes             String?
  /// false = non-GST bill PDF; true = GST tax invoice PDF
  withGst           Boolean          @default(false)
  subtotal          Float
  gstAmount         Float
  grandTotal        Float
  payableAmount     Float            @default(0)
  /// Brand/company cashback — not charged to customer; lifts profit selling price.
  companyDiscount   Float            @default(0)
  cashAmount        Float            @default(0)
  onlineAmount      Float            @default(0)
  cardAmount        Float            @default(0)
  financeAmount      Float            @default(0)
  financeCompanyId   String?
  financeCompanyName String?
  financeAmount2     Float            @default(0)
  financeCompanyId2  String?
  financeCompanyName2 String?
  /// Company 1 (or sole finance) received
  financeReceived    Boolean          @default(false)
  financeReceivedAt  DateTime?
  /// Company 2 received (only when financeAmount2 > 0)
  financeReceived2   Boolean          @default(false)
  financeReceivedAt2 DateTime?
  isExchange         Boolean          @default(false)
  exchangeModel      String?
  /// IOS | ANDROID — used when adding exchange phone to catalog as USED
  exchangePlatform   String?
  exchangeColor      String?
  exchangeStorage    String?
  exchangeRam        String?
  exchangeImei1      String?
  exchangeImei2      String?
  exchangeSerial     String?
  exchangeValue      Float?
  /// Cash paid back to customer from exchange value (fixed return).
  /// Bill credit = exchangeValue − exchangeCashReturn.
  exchangeCashReturn Float           @default(0)
  exchangeNotes      String?
  exchangeMobileCatalogId String?
  /// JSON array of extra exchange phones [{ model, platform, color, storage, ram, imei1, value, notes? }]
  exchangeItemsJson  String?
  dueAmount          Float            @default(0)
  dueDate           DateTime?
  dueSettled        Boolean          @default(false)
  dueSettledMethod  String?
  dueSettledAt      DateTime?
  isPartialPaid     Boolean          @default(false)
  createdByUserId   String?
  createdByName     String?
  /// ADMIN | STAFF
  createdByRole     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  items             BillItem[]
  duePayments       DuePayment[]
  financeCompany    FinanceCompany?  @relation(fields: [financeCompanyId], references: [id])

  @@index([billDate])
  @@index([customerPhone])
  @@index([dueAmount])
  @@index([financeCompanyId])
  @@index([createdByUserId])
}

model DuePayment {
  id        String   @id @default(cuid())
  billId    String
  amount    Float
  /// cash | online | card | na
  method    String
  /// partial | full
  kind      String   @default("partial")
  paidAt    DateTime @default(now())
  note      String?
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
  @@index([paidAt])
}

model BillItem {
  id             String  @id @default(cuid())
  billId         String
  productName    String
  mobileCatalogId String?
  stockItemId    String?
  platform       String?
  color          String?
  storage        String?
  ram            String?
  /// NEW | USED — copied from catalog when the bill is saved
  condition      String?
  quantity       Int     @default(1)
  rate           Float
  gstPercent     Float   @default(18)
  amount         Float
  imei1          String?
  imei2          String?
  serialNumber   String?
  /// Older bills only: warranty as a number of months
  warrantyMonths Int?
  /// Free text, e.g. "1 year", "6 months", "No warranty"
  warranty       String?
  /// Comma-separated BOX,CHARGER,CABLE,BILL handed to the customer with this phone
  includedAccessories String?
  bill           Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  mobileCatalog  MobileCatalog? @relation(fields: [mobileCatalogId], references: [id])
  stockItem      StockItem? @relation(fields: [stockItemId], references: [id])

  @@index([billId])
  @@index([mobileCatalogId])
  @@index([stockItemId])
}

model MobileCatalog {
  id        String   @id @default(cuid())
  name      String
  platform  String
  color     String
  storage   String
  ram       String   @default("")
  /// NEW | USED
  condition String   @default("NEW")
  createdAt DateTime @default(now())
  billItems BillItem[]

  @@unique([name, platform, color, storage, ram, condition])
  @@index([name])
  @@index([condition])
}

/// Phone model variants for stock search (no color — keeps list smaller).
model PhoneModel {
  id        String   @id @default(cuid())
  /// IOS | ANDROID
  platform  String
  name      String
  storage   String
  /// Empty for iOS
  ram       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, name, storage, ram])
  @@index([platform])
  @@index([name])
}

model FinanceCompany {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  bills     Bill[]
}

model InvoiceSequence {
  id      Int @id @default(1)
  counter Int @default(0)
}

/// Tracks automated / manual Excel report emails to avoid duplicates.
model ReportSendLog {
  id        String   @id @default(cuid())
  scope     String
  /// IST calendar day the report was for (YYYY-MM-DD)
  dateKey   String
  sentAt    DateTime @default(now())
  messageId String?
  toEmail   String?

  @@unique([scope, dateKey])
  @@index([dateKey])
}

/// Shop inventory unit (one phone = one IMEI and/or serial; accessories use serial).
model StockItem {
  id            String   @id @default(cuid())
  /// MOBILE | ACCESSORY
  kind          String   @default("MOBILE")
  /// NEW | USED (ACCESSORY uses NEW)
  condition     String
  /// IOS | ANDROID | ACCESSORY
  platform      String
  mobileName    String
  storage       String
  /// Required for ANDROID; empty for IOS / ACCESSORY
  ram           String   @default("")
  color         String
  /// Optional when serialNumber is set
  imei          String?  @unique
  /// Optional when imei is set; required for ACCESSORY
  serialNumber  String?  @unique
  purchasePrice Float
  /// Legacy JSON string array of supplier names (kept for old rows)
  suppliers     String   @default("[]")
  supplierId    String?
  /// AVAILABLE | SOLD
  status        String   @default("AVAILABLE")
  createdByUserId String?
  createdByName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  billItems     BillItem[]
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  purchaseItem  PurchaseItem?
  productReturn ProductReturn? @relation("ReturnedUnit")
  /// Set when this unit was given to a customer as a replacement.
  replacementFor ProductReturn? @relation("ReplacementUnit")

  @@index([kind])
  @@index([condition])
  @@index([status])
  @@index([mobileName])
  @@index([createdAt])
  @@index([supplierId])
  @@index([createdByUserId])
}

/// Party master — Tally-style supplier ledger.
model Supplier {
  id         String   @id @default(cuid())
  name       String   @unique
  phone      String?
  address    String?
  notes      String?
  /// True when this party came from a customer phone exchange (not a wholesale supplier).
  isExchange Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  purchases  Purchase[]
  payments   SupplierPayment[]
  stockItems StockItem[]
  productReturns ProductReturn[]

  @@index([name])
  @@index([isExchange])
  @@index([phone])
}

/// Purchase voucher: mobiles bought from one supplier in one entry.
model Purchase {
  id           String    @id @default(cuid())
  supplierId   String
  purchaseDate DateTime  @default(now())
  note         String?
  totalAmount  Float     @default(0)
  /// NEW | USED — condition of units in this purchase
  condition    String    @default("NEW")
  /// When set, this purchase is fully paid to the supplier
  paidAt       DateTime?
  /// Paid so far while not fully paid (custom part payments)
  paidAmount   Float     @default(0)
  createdByUserId String?
  createdByName   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  items        PurchaseItem[]
  /// Payment made while entering this purchase (Fully paid / Custom paid)
  payments     SupplierPayment[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([paidAt])
  @@index([createdByUserId])
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String
  stockItemId String    @unique
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

/// A sold unit sent back to its supplier (customer got a replacement or
/// refund). Its purchase price is credited to the supplier: the credit is
/// applied to unpaid purchases like a payment (creditApplied); any part that
/// could not be applied (nothing left unpaid) stays as supplier credit.
model ProductReturn {
  id              String    @id @default(cuid())
  stockItemId     String    @unique
  supplierId      String?
  /// Bill the unit was sold on (snapshot, the bill may change later)
  billId          String?
  billItemId      String?
  invoiceNumber   String?
  customerName    String?
  /// Purchase price credited to the supplier
  amount          Float     @default(0)
  creditApplied   Float     @default(0)
  /// REPLACE (customer got another unit from stock) | RETURN (customer got
  /// a refund). Null on entries made before this choice existed.
  kind            String?
  /// RETURN: money given back to the customer, and how (cash | online).
  refundAmount    Float     @default(0)
  refundMethod    String?
  /// REPLACE: the unit from stock given to the customer (marked SOLD).
  replacementStockItemId String? @unique
  note            String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime  @default(now())
  stockItem       StockItem @relation("ReturnedUnit", fields: [stockItemId], references: [id], onDelete: Cascade)
  replacementStock StockItem? @relation("ReplacementUnit", fields: [replacementStockItemId], references: [id], onDelete: SetNull)
  supplier        Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([billId])
  @@index([createdAt])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  amount     Float
  /// cash | online | na
  method     String
  paidAt     DateTime @default(now())
  note       String?
  /// Set when paid while entering this purchase ("Paid at purchase")
  purchaseId String?
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([supplierId])
  @@index([paidAt])
  @@index([purchaseId])
}

/// Recycle bin: a snapshot of everything a delete removed, kept for 30 days so
/// the delete can be undone. `payload` is JSON (rows by table).
model RecycleBinEntry {
  id            String   @id @default(cuid())
  /// BILL | SUPPLIER | STOCK
  kind          String
  label         String
  detail        String?
  payload       String
  deletedAt     DateTime @default(now())
  deletedById   String?
  deletedByName String?

  @@index([deletedAt])
}

/// Repair desk intake — kept separate from shop bills and stock.
model RepairJob {
  id                 String    @id @default(cuid())
  /// BMR-NX-0001… (main shop) or BMR-0001… (Luckey's shop)
  jobNumber          String    @unique
  /// Repair shop this job belongs to: NX | LK (lib/repairShops).
  shop               String    @default("NX")
  customerName       String
  customerPhone      String
  customerAddress    String?
  deviceName         String
  /// IOS | ANDROID
  platform           String
  color              String?
  /// Older jobs only — intake now asks for colour instead.
  ram                String?
  storage            String?
  /// LIKE_NEW | GOOD | FAIR | DAMAGED | DEAD
  condition          String
  conditionNotes     String?
  /// What the customer says is wrong.
  problemDescription String    @default("")
  /// Quoted at intake (optional).
  estimatedCost      Float?
  /// IMEI or serial number (scanned or typed at intake).
  imei               String?
  /// When the shop promised the phone back.
  expectedDeliveryAt DateTime?
  /// Screen lock / passcode, for testing. Never printed on the slip.
  lockCode           String?
  /// What came in with the phone, e.g. "SIM card, Back cover".
  accessories        String?
  /// Charged when the job is finished.
  finalCharge        Float?
  /// What the repair cost the shop (parts etc.). Admin only.
  costPrice          Float?
  /// RECEIVED → IN_REPAIR → REPAIRED → DELIVERED
  status             String    @default("RECEIVED")
  /// FIXED | NOT_FIXED — set when the work is done.
  outcome            String?
  /// What was done (parts changed, etc.).
  repairNotes        String?
  /// Tapped chips: work done when FIXED, reasons when NOT_FIXED ("A, B").
  workDone           String?
  /// How the customer paid at delivery: CASH | UPI | CARD.
  paymentMethod      String?
  /// Who collected the phone when it wasn't the customer (null = the customer).
  pickupName         String?
  pickupPhone        String?
  /// Last time the shop called the customer about this job.
  notifiedAt         DateTime?
  /// When the technician started working on it (IN_REPAIR).
  startedAt          DateTime?
  repairedAt         DateTime?
  deliveredAt        DateTime?
  /// Browser-compressed WebP/JPEG (≈80–200 KB each).
  frontPhoto         Bytes?
  frontPhotoType     String?
  backPhoto          Bytes?
  backPhotoType      String?
  createdByUserId    String?
  createdByName      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([createdAt])
  @@index([customerPhone])
  @@index([status])
  @@index([shop])
}

// ------------------------------------------------------------------
// Accessories shop (routes/acc). Its own catalogue, stock, sales,
// wholesale customers and suppliers: nothing here touches the mobile
// shop's bills or stock. Access is limited by phone (lib/accShop).
// ------------------------------------------------------------------

/// Top-level tile on the counter: Cover, Glass, Headphone…
model AccCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Second tap on the counter: TYPE (Silicone, Rubber…) or BRAND (boAt…)
  drillBy   String   @default("TYPE")
  /// lucide icon key picked in the UI (see client acc/icons)
  icon      String   @default("package")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  products  AccProduct[]
}

model AccProduct {
  id            String   @id @default(cuid())
  categoryId    String
  /// Display name, e.g. "Silicone Cover · Redmi Note 13"
  name          String
  /// Kind within the category: Silicone, Rubber, 9D, Privacy…
  type          String   @default("")
  brand         String   @default("")
  /// Phone the item fits, e.g. "Redmi Note 13" (covers, glass)
  model         String   @default("")
  color         String   @default("")
  barcode       String?  @unique
  /// Weighted average cost of units in stock
  purchasePrice Float    @default(0)
  /// Retail price shown first on the counter
  sellingPrice  Float    @default(0)
  /// Default rate on wholesale bills
  wholesalePrice Float   @default(0)
  /// JSON number array of quick price chips on the counter
  quickPrices   String   @default("[]")
  stockQty      Int      @default(0)
  /// Show as low stock at or below this (0 = off)
  lowStockAt    Int      @default(0)
  isFavourite   Boolean  @default(false)
  active        Boolean  @default(true)
  /// Last physical count (weekly stock check)
  countedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  category      AccCategory @relation(fields: [categoryId], references: [id])
  models        AccProductModel[]
  moves         AccStockMove[]
  saleItems     AccSaleItem[]
  purchaseItems AccPurchaseItem[]

  @@index([categoryId])
  @@index([isFavourite])
  @@index([name])
  @@index([active])
}

/// Every change to a product's stock, newest first in the product history.
/// How many of a product are for each phone model (e.g. 10 Silicone Cover
/// for iPhone 15 Pro). Only a record: the counter sells the product itself;
/// stockQty minus these is "not sorted".
model AccProductModel {
  id        String   @id @default(cuid())
  productId String
  model     String
  qty       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   AccProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, model])
  @@index([productId])
}

model AccStockMove {
  id        String   @id @default(cuid())
  productId String
  /// OPENING | PURCHASE | SALE | VOID | ADJUST | COUNT
  kind      String
  /// + in, − out
  qty       Int
  unitCost  Float    @default(0)
  /// Sale or purchase id
  refId     String?
  note      String?
  createdByName String?
  createdAt DateTime @default(now())
  product   AccProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([createdAt])
}

model AccCustomerGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#5d73b6")
  createdAt DateTime @default(now())
  customers AccCustomer[]
}

/// Wholesale buyer (a shop that takes stock on credit).
model AccCustomer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  shopName  String   @default("")
  address   String   @default("")
  city      String   @default("")
  gstin     String   @default("")
  groupId   String?
  /// 0 = no limit
  creditLimit Float  @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     AccCustomerGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  sales     AccSale[]
  payments  AccPayment[]

  @@index([groupId])
  @@index([name])
}

model AccSale {
  id          String   @id @default(cuid())
  /// AR-0001 (retail) / AW-0001 (wholesale)
  number      String   @unique
  /// RETAIL | WHOLESALE
  kind        String
  saleDate    DateTime @default(now())
  customerId  String?
  /// Optional for retail
  customerName  String @default("")
  customerPhone String @default("")
  subtotal    Float
  discount    Float    @default(0)
  total       Float
  /// Collected from the customer and passed through to the transporter; excluded from revenue/profit
  transportCharge Float @default(0)
  /// Cost of goods at the time of sale
  costTotal   Float    @default(0)
  cashAmount   Float   @default(0)
  onlineAmount Float   @default(0)
  /// Left unpaid on this bill (wholesale credit)
  dueAmount   Float    @default(0)
  dueDate     DateTime?
  note        String   @default("")
  /// Set by the device per submit; a repeated submit returns the same sale
  clientRef   String?  @unique
  voidedAt    DateTime?
  voidReason  String?
  createdByUserId String?
  createdByName   String?
  createdAt   DateTime @default(now())
  customer    AccCustomer? @relation(fields: [customerId], references: [id])
  items       AccSaleItem[]

  @@index([saleDate])
  @@index([kind])
  @@index([customerId])
  @@index([voidedAt])
}

model AccSaleItem {
  id         String   @id @default(cuid())
  saleId     String
  productId  String?
  name       String
  categoryName String @default("")
  /// Phone model picked at sale time (product breakdown), if any
  model      String   @default("")
  qty        Int
  rate       Float
  amount     Float
  unitCost   Float    @default(0)
  sale       AccSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product    AccProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([productId])
}

/// Money received from a wholesale customer against their balance.
model AccPayment {
  id         String   @id @default(cuid())
  customerId String
  amount     Float
  /// CASH | UPI | BANK | CHEQUE | DISCOUNT (written off)
  method     String
  paidAt     DateTime @default(now())
  note       String   @default("")
  createdByName String?
  createdAt  DateTime @default(now())
  customer   AccCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([paidAt])
}

/// Supplier group (e.g. Delhi market, Nagpur, Local) for sorting the list.
model AccSupplierGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#5d73b6")
  createdAt DateTime @default(now())
  suppliers AccSupplier[]
}

model AccSupplier {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String   @default("")
  city      String   @default("")
  address   String   @default("")
  groupId   String?
  createdAt DateTime @default(now())
  group     AccSupplierGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  purchases AccPurchase[]
  payments  AccSupplierPayment[]

  @@index([groupId])
}

/// Stock bought in one go (from a supplier or opening stock).
model AccPurchase {
  id           String   @id @default(cuid())
  supplierId   String?
  purchaseDate DateTime @default(now())
  billNo       String   @default("")
  total        Float    @default(0)
  note         String   @default("")
  createdByName String?
  createdAt    DateTime @default(now())
  supplier     AccSupplier? @relation(fields: [supplierId], references: [id])
  items        AccPurchaseItem[]

  @@index([supplierId])
  @@index([purchaseDate])
}

model AccPurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  productId  String
  qty        Int
  unitCost   Float
  purchase   AccPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    AccProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model AccSupplierPayment {
  id         String   @id @default(cuid())
  supplierId String
  amount     Float
  method     String
  paidAt     DateTime @default(now())
  /// UTR / cheque no., to match the bank statement
  reference  String   @default("")
  note       String   @default("")
  createdAt  DateTime @default(now())
  supplier   AccSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

/// Bill number counters for the accessories shop (key: RETAIL | WHOLESALE).
model AccCounter {
  key   String @id
  value Int    @default(0)
}
