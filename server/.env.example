DATABASE_URL="file:./dev.db"
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET="change-me-in-production"
NODE_ENV=development
SHOP_NAME="Suraj Mobile"
SHOP_TAGLINE="Deals In - All New & Second Hand Phones"
SHOP_ADDRESS="Near Jain Mandir, Beside Arihant Institute Main Road Balaghat (M.P) 481001"
SHOP_PHONE="9516533556"
SHOP_INSTAGRAM="@surajmobileofficial"
SHOP_GSTIN=""

# Gmail SMTP — nightly Excel reports (Asia/Kolkata)
# Create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER="surajmobilereports@gmail.com"
SMTP_PASS="your-16-char-app-password"
REPORT_EMAIL_TO="surajmobile33556@gmail.com"
# Optional SMTP host/port overrides. On Railway, prefer 587 (production default).
# The app also retries the other port on connection timeouts.
# SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
# Optional display from:
# SMTP_FROM="Suraj Mobile Reports <surajmobilereports@gmail.com>"
# 11:00 PM IST every day (today's bills). Sundays also send full backup.
REPORT_CRON="0 23 * * *"
REPORT_CRON_ENABLED="true"
# Secret for Railway Cron Job → POST /api/reports/cron/run
# (Authorization: Bearer <secret>  or  x-cron-secret: <secret>)
REPORT_CRON_SECRET="long-random-cron-secret"

# --- Railway production example ---
# DATABASE_URL="file:/data/suraj.db"
# CLIENT_ORIGIN="*"
# JWT_SECRET="long-random-secret"
# NODE_ENV=production
# (Mount a Railway Volume at /data so SQLite persists)
# Also set SMTP_USER, SMTP_PASS, REPORT_EMAIL_TO, SMTP_PORT=587, REPORT_CRON_SECRET
# Then add a Railway Cron Job:
#   Schedule: 0 23 * * *  (or Railway's equivalent for 11:00 PM IST)
#   OR use cron timezone Asia/Kolkata if available
#   URL: https://YOUR_APP.up.railway.app/api/reports/cron/run
#   Method: POST
#   Header: Authorization: Bearer <REPORT_CRON_SECRET>
