# Railway blocks outbound SMTP — use Resend HTTPS (recommended for production):
# 1) Sign up at https://resend.com  2) Create API key  3) set RESEND_API_KEY
# Free tier can send from onboarding@resend.dev (or set RESEND_FROM after verifying a domain)
RESEND_API_KEY=""
# RESEND_FROM="Suraj Mobile Reports <onboarding@resend.dev>"
# Local Gmail SMTP (works on your PC; usually times out on Railway):
SMTP_USER="surajmobilereports@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_PORT=587
# SMTP_HOST="smtp.gmail.com"
# SMTP_FROM="Suraj Mobile Reports <surajmobilereports@gmail.com>"
REPORT_CRON="0 23 * * 0,3"
REPORT_CRON_ENABLED="true"
REPORT_CRON_SECRET="long-random-cron-secret"

# --- Railway production example ---
# DATABASE_URL="file:/data/suraj.db"
